generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Company {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(100)
  gstNo             String?   @db.VarChar(50)
  email             String?   @db.VarChar(100)
  date              DateTime  @db.Date
  status            String    @default("active") @db.VarChar(20)
  ssiNo             String?   @db.VarChar(50)
  panNo             String?   @db.VarChar(20)
  phone             String?   @db.VarChar(20)
  esiNo             String?   @db.VarChar(50)
  address           String?   @db.Text
  epfNo             String?   @db.VarChar(50)
  logoUrl           String?   @map("logo_url") @db.LongText
  state             String?   @db.VarChar(50)
  stateCode         String?   @map("state_code") @db.VarChar(5)
  bankHolderName    String?   @map("bank_holder_name") @db.VarChar(100)
  bankAccountNumber String?   @map("bank_account_number") @db.VarChar(30)
  bankIfscCode      String?   @map("bank_ifsc_code") @db.VarChar(20)
  bankName          String?   @map("bank_name") @db.VarChar(100)
  bankBranchName    String?   @map("bank_branch_name") @db.VarChar(100)
  website           String?   @db.VarChar(200)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  adminId           Int?      @map("admin_id")
  workspace         User?     @relation("CompanyWorkspace", fields: [adminId], references: [id], onDelete: Restrict)
  invoices          Invoice[]

  @@index([adminId])
  @@map("companies")
}

model ToCompany {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  gstNo           String?   @db.VarChar(50)
  vendorCode      String?   @map("vendor_code") @db.VarChar(50)
  email           String?   @db.VarChar(100)
  address         String?   @db.Text
  state           String?   @db.VarChar(50)
  stateCode       String?   @map("state_code") @db.VarChar(5)
  date            DateTime  @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  adminId         Int?      @map("admin_id")
  billedInvoices  Invoice[] @relation("BillTo")
  shippedInvoices Invoice[] @relation("ShipTo")
  invoices        Invoice[]
  workspace       User?     @relation("ToCompanyWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@map("to_companies")
}

model Referral {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String?  @db.VarChar(100)
  mobile    String?  @db.VarChar(20)
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  adminId   Int?     @map("admin_id")
  workspace User?    @relation("ReferralWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@map("referrals")
}

model Invoice {
  id                 Int           @id @default(autoincrement())
  orderId            String        @map("order_id") @db.VarChar(50)
  companyId          Int?          @map("company_id")
  toCompanyId        Int?          @map("to_company_id")
  billToCompanyId    Int?          @map("bill_to_company_id")
  shipToCompanyId    Int?          @map("ship_to_company_id")
  email              String?       @db.VarChar(100)
  gst                String?       @db.VarChar(50)
  amount             Decimal?      @db.Decimal(12, 2)
  total              Decimal?      @db.Decimal(12, 2)
  date               DateTime      @db.Date
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  taxType            String        @default("CGST_SGST") @map("tax_type") @db.VarChar(20)
  cgstRate           Decimal       @default(0.00) @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate           Decimal       @default(0.00) @map("sgst_rate") @db.Decimal(5, 2)
  igstRate           Decimal       @default(0.00) @map("igst_rate") @db.Decimal(5, 2)
  reverseCharge      Boolean       @default(false) @map("reverse_charge")
  invoiceNo          String?       @map("invoice_no") @db.VarChar(20)
  documentType       String        @default("TAX_INVOICE") @map("document_type") @db.VarChar(20)
  discountAmount     Decimal       @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  kindAttn            String?       @map("kind_attn") @db.VarChar(150)
  mobileNo            String?       @map("mobile_no") @db.VarChar(30)
  poNumber            String?       @map("po_number") @db.VarChar(50)
  poDate              DateTime?     @map("po_date") @db.Date
  challanNo          String?       @map("challan_no") @db.VarChar(50)
  transportMode      String?       @map("transport_mode") @db.VarChar(50)
  vehicleNo          String?       @map("vehicle_no") @db.VarChar(50)
  dateOfSupply       DateTime?     @map("date_of_supply") @db.Date
  placeOfSupply      String?       @map("place_of_supply") @db.VarChar(100)
  stateCode          String?       @map("state_code") @db.VarChar(5)
  bankHolderName     String?       @map("bank_holder_name") @db.VarChar(100)
  bankAccountNumber  String?       @map("bank_account_number") @db.VarChar(50)
  bankIfscCode       String?       @map("bank_ifsc_code") @db.VarChar(20)
  bankName           String?       @map("bank_name") @db.VarChar(100)
  bankBranchName     String?       @map("bank_branch_name") @db.VarChar(100)
  billToName         String?       @map("bill_to_name") @db.VarChar(200)
  billToAddress      String?       @map("bill_to_address") @db.VarChar(500)
  billToGstin        String?       @map("bill_to_gstin") @db.VarChar(50)
  billToEmail        String?       @map("bill_to_email") @db.VarChar(100)
  billToState        String?       @map("bill_to_state") @db.VarChar(50)
  billToStateCode    String?       @map("bill_to_state_code") @db.VarChar(5)
  shipToName         String?       @map("ship_to_name") @db.VarChar(200)
  shipToAddress      String?       @map("ship_to_address") @db.VarChar(500)
  shipToGstin        String?       @map("ship_to_gstin") @db.VarChar(50)
  shipToEmail        String?       @map("ship_to_email") @db.VarChar(100)
  shipToState        String?       @map("ship_to_state") @db.VarChar(50)
  shipToStateCode    String?       @map("ship_to_state_code") @db.VarChar(5)
  termsAndConditions String?       @map("terms_and_conditions") @db.Text
  logoUrl            String?       @map("logo_url") @db.LongText
  phone              String?       @map("phone") @db.VarChar(100)
  adminId            Int?          @map("admin_id")
  items              InvoiceItem[]
  workspace          User?         @relation("InvoiceWorkspace", fields: [adminId], references: [id], onDelete: Restrict)
  billToCompany      ToCompany?    @relation("BillTo", fields: [billToCompanyId], references: [id])
  company            Company?      @relation(fields: [companyId], references: [id])
  shipToCompany      ToCompany?    @relation("ShipTo", fields: [shipToCompanyId], references: [id])
  toCompany          ToCompany?    @relation(fields: [toCompanyId], references: [id])

  @@index([adminId])
  @@index([adminId, invoiceNo])
  @@index([adminId, documentType])
  @@index([billToCompanyId], map: "invoices_bill_to_company_id_fkey")
  @@index([companyId], map: "invoices_company_id_fkey")
  @@index([shipToCompanyId], map: "invoices_ship_to_company_id_fkey")
  @@index([toCompanyId], map: "invoices_to_company_id_fkey")
  @@map("invoices")
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @map("invoice_id")
  description String?  @db.VarChar(255)
  hsn         String?  @db.VarChar(20)
  sac         String?  @db.VarChar(20)
  quantity    Decimal  @default(0.00) @db.Decimal(10, 2)
  unit        String   @default("Pcs") @db.VarChar(10)
  price       Decimal  @default(0.00) @db.Decimal(12, 2)
  per         String   @default("Pcs") @db.VarChar(10)
  amount      Decimal  @default(0.00) @db.Decimal(12, 2)
  gstType     String?  @map("gst_type") @db.VarChar(20)
  igstRate    Decimal? @map("igst_rate") @db.Decimal(5, 2)
  cgstRate    Decimal? @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate    Decimal? @map("sgst_rate") @db.Decimal(5, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "invoice_items_invoice_id_fkey")
  @@map("invoice_items")
}

model Purchase {
  id           Int      @id @default(autoincrement())
  gstNo        String?  @map("gst_no") @db.VarChar(50)
  partyName    String   @map("party_name") @db.VarChar(100)
  invoiceNo    String   @map("invoice_no") @db.VarChar(50)
  invoiceDate  DateTime @map("invoice_date") @db.Date
  state        String?  @db.VarChar(50)
  rate         Decimal  @default(0.00) @db.Decimal(5, 2)
  taxableValue Decimal  @default(0.00) @map("taxable_value") @db.Decimal(12, 2)
  igst         Decimal  @default(0.00) @db.Decimal(12, 2)
  cgst         Decimal  @default(0.00) @db.Decimal(12, 2)
  sgst         Decimal  @default(0.00) @db.Decimal(12, 2)
  totalAmount  Decimal  @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  adminId      Int?     @map("admin_id")
  workspace    User?    @relation("PurchaseWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, invoiceDate])
  @@map("purchases")
}

model User {
  id                    Int              @id @default(autoincrement())
  firstName             String           @map("first_name") @db.VarChar(50)
  lastName              String           @map("last_name") @db.VarChar(50)
  username              String           @unique @db.VarChar(50)
  password              String           @db.VarChar(255)
  email                 String?          @db.VarChar(100)
  phone                 String?          @db.VarChar(20)
  role                  String           @default("user") @db.VarChar(20)
  status                String           @default("active") @db.VarChar(20)
  sidebarAccess         String?          @map("sidebar_access") @db.Text
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  adminId               Int?             @map("admin_id")
  superadminKey         String?          @unique @map("superadmin_key") @db.VarChar(20)
  auditEntries          AuditLog[]       @relation("AuditActor")
  workspaceAuditEntries AuditLog[]       @relation("AuditWorkspace")
  backupHistory         BackupHistory[]  @relation("BackupWorkspace")
  companies             Company[]        @relation("CompanyWorkspace")
  deliveryChallans      DeliveryChallan[] @relation("DeliveryChallanWorkspace")
  exportHistory         ExportHistory[]  @relation("ExportWorkspace")
  importHistory         ImportHistory[]  @relation("ImportWorkspace")
  invoiceSequence       InvoiceSequence? @relation("WorkspaceInvoiceSequence")
  invoices              Invoice[]        @relation("InvoiceWorkspace")
  settings              WorkspaceSetting[]
  purchases             Purchase[]       @relation("PurchaseWorkspace")
  vendors               Vendor[]         @relation("VendorWorkspace")
  purchaseOrders        PurchaseOrder[]  @relation("PurchaseOrderWorkspace")
  referrals             Referral[]       @relation("ReferralWorkspace")
  sessions              Session[]
  toCompanies           ToCompany[]      @relation("ToCompanyWorkspace")
  admin                 User?            @relation("AdminWorkspace", fields: [adminId], references: [id])
  users                 User[]           @relation("AdminWorkspace")

  @@index([adminId, role, status])
  @@map("users")
}

model Vendor {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(150)
  industry        String?  @db.VarChar(100)
  email           String?  @db.VarChar(150)
  website         String?  @db.VarChar(200)
  landline        String?  @db.VarChar(30)
  mobile          String?  @db.VarChar(30)
  addressLine1    String?  @map("address_line1") @db.VarChar(255)
  addressLine2    String?  @map("address_line2") @db.VarChar(255)
  gstnType        String   @default("REGISTERED_REGULAR") @map("gstn_type") @db.VarChar(40)
  gstin           String?  @db.VarChar(20)
  pan             String?  @db.VarChar(20)
  currency        String   @default("INR") @db.VarChar(10)
  country         String   @default("India") @db.VarChar(80)
  state           String?  @db.VarChar(80)
  pinCode         String?  @map("pin_code") @db.VarChar(12)
  tcsEnabled      Boolean  @default(false) @map("tcs_enabled")
  tcsRate         Decimal  @default(0) @map("tcs_rate") @db.Decimal(5,2)
  openingDate     DateTime? @map("opening_date") @db.Date
  openingType     String   @default("CREDIT") @map("opening_type") @db.VarChar(10)
  openingAmount   Decimal  @default(0) @map("opening_amount") @db.Decimal(14,2)
  portalEnabled   Boolean  @default(false) @map("portal_enabled")
  status          String   @default("active") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  adminId         Int      @map("admin_id")
  workspace       User     @relation("VendorWorkspace", fields: [adminId], references: [id], onDelete: Restrict)
  purchaseOrders  PurchaseOrder[]
  @@unique([adminId, gstin])
  @@index([adminId, name])
  @@map("vendors")
}

model PurchaseOrder {
  id              Int      @id @default(autoincrement())
  poNumber        String   @map("po_number") @db.VarChar(40)
  vendorId        Int      @map("vendor_id")
  vendorName      String   @map("vendor_name") @db.VarChar(150)
  gstin           String?  @db.VarChar(20)
  contactName     String?  @map("contact_name") @db.VarChar(120)
  orderDate       DateTime @map("order_date") @db.Date
  quoteNo         String?  @map("quote_no") @db.VarChar(60)
  quoteDate       DateTime? @map("quote_date") @db.Date
  currency        String   @default("INR") @db.VarChar(10)
  shippingAddress String?  @map("shipping_address") @db.Text
  senderDetails   String?  @map("sender_details") @db.Text
  subtotal        Decimal  @default(0) @db.Decimal(14,2)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(14,2)
  igstAmount      Decimal  @default(0) @map("igst_amount") @db.Decimal(14,2)
  cgstAmount      Decimal  @default(0) @map("cgst_amount") @db.Decimal(14,2)
  sgstAmount      Decimal  @default(0) @map("sgst_amount") @db.Decimal(14,2)
  cessAmount      Decimal  @default(0) @map("cess_amount") @db.Decimal(14,2)
  grandTotal      Decimal  @default(0) @map("grand_total") @db.Decimal(14,2)
  status          String   @default("DRAFT") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  adminId         Int      @map("admin_id")
  workspace       User     @relation("PurchaseOrderWorkspace", fields: [adminId], references: [id], onDelete: Restrict)
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items           PurchaseOrderItem[]
  @@unique([adminId, poNumber])
  @@index([adminId, orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id             Int      @id @default(autoincrement())
  purchaseOrderId Int     @map("purchase_order_id")
  productName    String   @map("product_name") @db.VarChar(180)
  description    String?  @db.VarChar(255)
  itemType       String   @default("GOODS") @map("item_type") @db.VarChar(20)
  hsnSac         String?  @map("hsn_sac") @db.VarChar(30)
  quantity       Decimal  @default(1) @db.Decimal(12,3)
  uom            String   @default("Nos") @db.VarChar(20)
  unitRate       Decimal  @default(0) @map("unit_rate") @db.Decimal(14,2)
  discountRate   Decimal  @default(0) @map("discount_rate") @db.Decimal(5,2)
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(5,2)
  taxType        String   @default("AUTO") @map("tax_type") @db.VarChar(20)
  taxableAmount  Decimal  @default(0) @map("taxable_amount") @db.Decimal(14,2)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(14,2)
  totalAmount    Decimal  @default(0) @map("total_amount") @db.Decimal(14,2)
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id           Int      @id @default(autoincrement())
  usernameHash String   @map("username_hash") @db.Char(64)
  ipHash       String   @map("ip_hash") @db.Char(64)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([usernameHash, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_attempts")
}

model ImportHistory {
  id        Int      @id @default(autoincrement())
  module    String   @db.VarChar(50)
  fileName  String   @map("file_name") @db.VarChar(255)
  fileType  String   @map("file_type") @db.VarChar(20)
  fileSize  String   @map("file_size") @db.VarChar(20)
  status    String   @db.VarChar(20)
  user      String   @db.VarChar(50)
  imported  Int      @default(0)
  skipped   Int      @default(0)
  failed    Int      @default(0)
  errorMsg  String?  @map("error_message") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  adminId   Int?     @map("admin_id")
  workspace User?    @relation("ImportWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@map("import_history")
}

model ExportHistory {
  id          Int      @id @default(autoincrement())
  module      String   @db.VarChar(50)
  fileName    String   @map("file_name") @db.VarChar(255)
  fileType    String   @map("file_type") @db.VarChar(20)
  fileSize    String   @map("file_size") @db.VarChar(20)
  format      String   @db.VarChar(20)
  status      String   @db.VarChar(20)
  user        String   @db.VarChar(50)
  recordCount Int      @default(0) @map("record_count")
  errorMsg    String?  @map("error_message") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  adminId     Int?     @map("admin_id")
  workspace   User?    @relation("ExportWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@map("export_history")
}

model BackupHistory {
  id          Int      @id @default(autoincrement())
  module      String   @db.VarChar(50)
  fileName    String   @map("file_name") @db.VarChar(255)
  fileType    String   @map("file_type") @db.VarChar(20)
  fileSize    String   @map("file_size") @db.VarChar(20)
  format      String   @db.VarChar(20)
  status      String   @db.VarChar(20)
  user        String   @db.VarChar(50)
  recordCount Int      @default(0) @map("record_count")
  errorMsg    String?  @map("error_message") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  adminId     Int?     @map("admin_id")
  workspace   User?    @relation("BackupWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@map("backup_history")
}

model InvoiceSequence {
  adminId      Int      @id @map("admin_id")
  currentValue Int      @default(0) @map("current_value")
  updatedAt    DateTime @updatedAt @map("updated_at")
  workspace    User     @relation("WorkspaceInvoiceSequence", fields: [adminId], references: [id])

  @@map("invoice_sequences")
}

model ProformaSequence {
  adminId      Int      @id @map("admin_id")
  currentValue Int      @default(0) @map("current_value")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("proforma_sequences")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int      @map("actor_id")
  adminId   Int?     @map("admin_id")
  action    String   @db.VarChar(80)
  targetId  Int?     @map("target_id")
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  actor     User     @relation("AuditActor", fields: [actorId], references: [id])
  workspace User?    @relation("AuditWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model WorkspaceSetting {
  adminId   Int      @map("admin_id")
  key       String   @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  workspace User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([adminId, key])
  @@map("workspace_settings")
}

model DeliveryChallan {
  id               Int                  @id @default(autoincrement())
  adminId          Int                  @map("admin_id")
  challanNumber    String               @map("challan_number") @db.VarChar(50)
  challanDate      DateTime             @map("challan_date") @db.Date
  deliveryDate     DateTime?            @map("delivery_date") @db.Date
  companyId        Int?                 @map("company_id")
  companyName      String               @map("company_name") @db.VarChar(200)
  companyAddress   String?              @map("company_address") @db.Text
  companyGstin     String?              @map("company_gstin") @db.VarChar(50)
  companyPhone     String?              @map("company_phone") @db.VarChar(30)
  recipientId      Int?                 @map("recipient_id")
  recipientName    String               @map("recipient_name") @db.VarChar(200)
  recipientAddress String?              @map("recipient_address") @db.Text
  recipientGstin   String?              @map("recipient_gstin") @db.VarChar(50)
  recipientState   String?              @map("recipient_state") @db.VarChar(100)
  poNumber         String?              @map("po_number") @db.VarChar(100)
  poDate           DateTime?            @map("po_date") @db.Date
  currency         String               @default("INR") @db.VarChar(10)
  stateOfSupply    String?              @map("state_of_supply") @db.VarChar(100)
  vehicleNumber    String?              @map("vehicle_number") @db.VarChar(50)
  transporterName  String?              @map("transporter_name") @db.VarChar(200)
  reason           String?              @db.Text
  remarks          String?              @db.Text
  status           String               @default("DRAFT") @db.VarChar(20)
  cancelReason     String?              @map("cancel_reason") @db.Text
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  workspace        User                 @relation("DeliveryChallanWorkspace", fields: [adminId], references: [id], onDelete: Restrict)
  items            DeliveryChallanItem[]

  @@unique([adminId, challanNumber], map: "delivery_challans_admin_id_challan_number_key")
  @@index([adminId, challanDate], map: "delivery_challans_admin_id_challan_date_idx")
  @@index([companyId], map: "delivery_challans_company_id_idx")
  @@index([recipientId], map: "delivery_challans_recipient_id_idx")
  @@map("delivery_challans")
}

model DeliveryChallanItem {
  id                Int             @id @default(autoincrement())
  deliveryChallanId Int             @map("delivery_challan_id")
  description       String          @db.VarChar(255)
  hsn               String?         @db.VarChar(20)
  quantity          String          @db.VarChar(30)
  uom               String          @default("Pcs") @db.VarChar(20)
  challan           DeliveryChallan @relation(fields: [deliveryChallanId], references: [id], onDelete: Cascade)

  @@index([deliveryChallanId], map: "delivery_challan_items_delivery_challan_id_idx")
  @@map("delivery_challan_items")
}

