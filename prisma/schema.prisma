generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Company {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(100)
  gstNo             String?   @db.VarChar(50)
  email             String?   @db.VarChar(100)
  date              DateTime  @db.Date
  status            String    @default("active") @db.VarChar(20)
  ssiNo             String?   @db.VarChar(50)
  panNo             String?   @db.VarChar(20)
  phone             String?   @db.VarChar(20)
  esiNo             String?   @db.VarChar(50)
  address           String?   @db.Text
  epfNo             String?   @db.VarChar(50)
  state             String?   @db.VarChar(50)
  stateCode         String?   @map("state_code") @db.VarChar(5)
  bankHolderName    String?   @map("bank_holder_name") @db.VarChar(100)
  bankAccountNumber String?   @map("bank_account_number") @db.VarChar(30)
  bankIfscCode      String?   @map("bank_ifsc_code") @db.VarChar(20)
  bankName          String?   @map("bank_name") @db.VarChar(100)
  bankBranchName    String?   @map("bank_branch_name") @db.VarChar(100)
  website           String?   @db.VarChar(200)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  adminId           Int?      @map("admin_id")
  workspace         User?     @relation("CompanyWorkspace", fields: [adminId], references: [id], onDelete: Restrict)
  invoices          Invoice[]

  @@index([adminId])
  @@map("companies")
}

model ToCompany {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  gstNo           String?   @db.VarChar(50)
  vendorCode      String?   @map("vendor_code") @db.VarChar(50)
  email           String?   @db.VarChar(100)
  address         String?   @db.Text
  state           String?   @db.VarChar(50)
  stateCode       String?   @map("state_code") @db.VarChar(5)
  date            DateTime  @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  adminId         Int?      @map("admin_id")
  billedInvoices  Invoice[] @relation("BillTo")
  shippedInvoices Invoice[] @relation("ShipTo")
  invoices        Invoice[]
  workspace       User?     @relation("ToCompanyWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@map("to_companies")
}

model Referral {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String?  @db.VarChar(100)
  mobile    String?  @db.VarChar(20)
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  adminId   Int?     @map("admin_id")
  workspace User?    @relation("ReferralWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@map("referrals")
}

model Invoice {
  id                 Int           @id @default(autoincrement())
  orderId            String        @map("order_id") @db.VarChar(50)
  companyId          Int?          @map("company_id")
  toCompanyId        Int?          @map("to_company_id")
  billToCompanyId    Int?          @map("bill_to_company_id")
  shipToCompanyId    Int?          @map("ship_to_company_id")
  email              String?       @db.VarChar(100)
  gst                String?       @db.VarChar(50)
  amount             Decimal?      @db.Decimal(12, 2)
  total              Decimal?      @db.Decimal(12, 2)
  date               DateTime      @db.Date
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  taxType            String        @default("CGST_SGST") @map("tax_type") @db.VarChar(20)
  cgstRate           Decimal       @default(0.00) @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate           Decimal       @default(0.00) @map("sgst_rate") @db.Decimal(5, 2)
  igstRate           Decimal       @default(0.00) @map("igst_rate") @db.Decimal(5, 2)
  reverseCharge      Boolean       @default(false) @map("reverse_charge")
  invoiceNo          String?       @map("invoice_no") @db.VarChar(20)
  challanNo          String?       @map("challan_no") @db.VarChar(50)
  transportMode      String?       @map("transport_mode") @db.VarChar(50)
  vehicleNo          String?       @map("vehicle_no") @db.VarChar(50)
  dateOfSupply       DateTime?     @map("date_of_supply") @db.Date
  placeOfSupply      String?       @map("place_of_supply") @db.VarChar(100)
  stateCode          String?       @map("state_code") @db.VarChar(5)
  bankHolderName     String?       @map("bank_holder_name") @db.VarChar(100)
  bankAccountNumber  String?       @map("bank_account_number") @db.VarChar(50)
  bankIfscCode       String?       @map("bank_ifsc_code") @db.VarChar(20)
  bankName           String?       @map("bank_name") @db.VarChar(100)
  bankBranchName     String?       @map("bank_branch_name") @db.VarChar(100)
  billToName         String?       @map("bill_to_name") @db.VarChar(200)
  billToAddress      String?       @map("bill_to_address") @db.VarChar(500)
  billToGstin        String?       @map("bill_to_gstin") @db.VarChar(50)
  billToEmail        String?       @map("bill_to_email") @db.VarChar(100)
  billToState        String?       @map("bill_to_state") @db.VarChar(50)
  billToStateCode    String?       @map("bill_to_state_code") @db.VarChar(5)
  shipToName         String?       @map("ship_to_name") @db.VarChar(200)
  shipToAddress      String?       @map("ship_to_address") @db.VarChar(500)
  shipToGstin        String?       @map("ship_to_gstin") @db.VarChar(50)
  shipToEmail        String?       @map("ship_to_email") @db.VarChar(100)
  shipToState        String?       @map("ship_to_state") @db.VarChar(50)
  shipToStateCode    String?       @map("ship_to_state_code") @db.VarChar(5)
  termsAndConditions String?       @map("terms_and_conditions") @db.Text
  logoUrl            String?       @map("logo_url") @db.LongText
  phone              String?       @map("phone") @db.VarChar(100)
  adminId            Int?          @map("admin_id")
  items              InvoiceItem[]
  workspace          User?         @relation("InvoiceWorkspace", fields: [adminId], references: [id], onDelete: Restrict)
  billToCompany      ToCompany?    @relation("BillTo", fields: [billToCompanyId], references: [id])
  company            Company?      @relation(fields: [companyId], references: [id])
  shipToCompany      ToCompany?    @relation("ShipTo", fields: [shipToCompanyId], references: [id])
  toCompany          ToCompany?    @relation(fields: [toCompanyId], references: [id])

  @@index([adminId])
  @@index([adminId, invoiceNo])
  @@index([billToCompanyId], map: "invoices_bill_to_company_id_fkey")
  @@index([companyId], map: "invoices_company_id_fkey")
  @@index([shipToCompanyId], map: "invoices_ship_to_company_id_fkey")
  @@index([toCompanyId], map: "invoices_to_company_id_fkey")
  @@map("invoices")
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @map("invoice_id")
  description String?  @db.VarChar(255)
  hsn         String?  @db.VarChar(20)
  sac         String?  @db.VarChar(20)
  quantity    Decimal  @default(0.00) @db.Decimal(10, 2)
  unit        String   @default("Pcs") @db.VarChar(10)
  price       Decimal  @default(0.00) @db.Decimal(12, 2)
  per         String   @default("Pcs") @db.VarChar(10)
  amount      Decimal  @default(0.00) @db.Decimal(12, 2)
  gstType     String?  @map("gst_type") @db.VarChar(20)
  igstRate    Decimal? @map("igst_rate") @db.Decimal(5, 2)
  cgstRate    Decimal? @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate    Decimal? @map("sgst_rate") @db.Decimal(5, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "invoice_items_invoice_id_fkey")
  @@map("invoice_items")
}

model Purchase {
  id           Int      @id @default(autoincrement())
  gstNo        String?  @map("gst_no") @db.VarChar(50)
  partyName    String   @map("party_name") @db.VarChar(100)
  invoiceNo    String   @map("invoice_no") @db.VarChar(50)
  invoiceDate  DateTime @map("invoice_date") @db.Date
  state        String?  @db.VarChar(50)
  rate         Decimal  @default(0.00) @db.Decimal(5, 2)
  taxableValue Decimal  @default(0.00) @map("taxable_value") @db.Decimal(12, 2)
  igst         Decimal  @default(0.00) @db.Decimal(12, 2)
  cgst         Decimal  @default(0.00) @db.Decimal(12, 2)
  sgst         Decimal  @default(0.00) @db.Decimal(12, 2)
  totalAmount  Decimal  @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  adminId      Int?     @map("admin_id")
  workspace    User?    @relation("PurchaseWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, invoiceDate])
  @@map("purchases")
}

model User {
  id                    Int              @id @default(autoincrement())
  firstName             String           @map("first_name") @db.VarChar(50)
  lastName              String           @map("last_name") @db.VarChar(50)
  username              String           @unique @db.VarChar(50)
  password              String           @db.VarChar(255)
  email                 String?          @db.VarChar(100)
  phone                 String?          @db.VarChar(20)
  role                  String           @default("user") @db.VarChar(20)
  status                String           @default("active") @db.VarChar(20)
  sidebarAccess         String?          @map("sidebar_access") @db.Text
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  adminId               Int?             @map("admin_id")
  superadminKey         String?          @unique @map("superadmin_key") @db.VarChar(20)
  auditEntries          AuditLog[]       @relation("AuditActor")
  workspaceAuditEntries AuditLog[]       @relation("AuditWorkspace")
  backupHistory         BackupHistory[]  @relation("BackupWorkspace")
  companies             Company[]        @relation("CompanyWorkspace")
  exportHistory         ExportHistory[]  @relation("ExportWorkspace")
  importHistory         ImportHistory[]  @relation("ImportWorkspace")
  invoiceSequence       InvoiceSequence? @relation("WorkspaceInvoiceSequence")
  invoices              Invoice[]        @relation("InvoiceWorkspace")
  settings              WorkspaceSetting[]
  purchases             Purchase[]       @relation("PurchaseWorkspace")
  referrals             Referral[]       @relation("ReferralWorkspace")
  sessions              Session[]
  toCompanies           ToCompany[]      @relation("ToCompanyWorkspace")
  admin                 User?            @relation("AdminWorkspace", fields: [adminId], references: [id])
  users                 User[]           @relation("AdminWorkspace")

  @@index([adminId, role, status])
  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id           Int      @id @default(autoincrement())
  usernameHash String   @map("username_hash") @db.Char(64)
  ipHash       String   @map("ip_hash") @db.Char(64)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([usernameHash, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_attempts")
}

model ImportHistory {
  id        Int      @id @default(autoincrement())
  module    String   @db.VarChar(50)
  fileName  String   @map("file_name") @db.VarChar(255)
  fileType  String   @map("file_type") @db.VarChar(20)
  fileSize  String   @map("file_size") @db.VarChar(20)
  status    String   @db.VarChar(20)
  user      String   @db.VarChar(50)
  imported  Int      @default(0)
  skipped   Int      @default(0)
  failed    Int      @default(0)
  errorMsg  String?  @map("error_message") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  adminId   Int?     @map("admin_id")
  workspace User?    @relation("ImportWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@map("import_history")
}

model ExportHistory {
  id          Int      @id @default(autoincrement())
  module      String   @db.VarChar(50)
  fileName    String   @map("file_name") @db.VarChar(255)
  fileType    String   @map("file_type") @db.VarChar(20)
  fileSize    String   @map("file_size") @db.VarChar(20)
  format      String   @db.VarChar(20)
  status      String   @db.VarChar(20)
  user        String   @db.VarChar(50)
  recordCount Int      @default(0) @map("record_count")
  errorMsg    String?  @map("error_message") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  adminId     Int?     @map("admin_id")
  workspace   User?    @relation("ExportWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@map("export_history")
}

model BackupHistory {
  id          Int      @id @default(autoincrement())
  module      String   @db.VarChar(50)
  fileName    String   @map("file_name") @db.VarChar(255)
  fileType    String   @map("file_type") @db.VarChar(20)
  fileSize    String   @map("file_size") @db.VarChar(20)
  format      String   @db.VarChar(20)
  status      String   @db.VarChar(20)
  user        String   @db.VarChar(50)
  recordCount Int      @default(0) @map("record_count")
  errorMsg    String?  @map("error_message") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  adminId     Int?     @map("admin_id")
  workspace   User?    @relation("BackupWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@map("backup_history")
}

model InvoiceSequence {
  adminId      Int      @id @map("admin_id")
  currentValue Int      @default(0) @map("current_value")
  updatedAt    DateTime @updatedAt @map("updated_at")
  workspace    User     @relation("WorkspaceInvoiceSequence", fields: [adminId], references: [id])

  @@map("invoice_sequences")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int      @map("actor_id")
  adminId   Int?     @map("admin_id")
  action    String   @db.VarChar(80)
  targetId  Int?     @map("target_id")
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  actor     User     @relation("AuditActor", fields: [actorId], references: [id])
  workspace User?    @relation("AuditWorkspace", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model WorkspaceSetting {
  adminId   Int      @map("admin_id")
  key       String   @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  workspace User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([adminId, key])
  @@map("workspace_settings")
}
